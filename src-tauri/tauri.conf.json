{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScribeFloat",
  "version": "0.2.195",
  "identifier": "com.benjamin.scribefloat-v8",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "bundled-models/ggml-small.en-q5_1.bin": "ggml-small.en-q5_1.bin",
      "bundled-models/ggml-silero-v6.2.0.bin": "ggml-silero-v6.2.0.bin",
      "bundled-models/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx": "3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx",
      "bundled-models/diar_streaming_sortformer_4spk-v2.onnx": "diar_streaming_sortformer_4spk-v2.onnx"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

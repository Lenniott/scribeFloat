{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/ui-enforcement-check.mjs",
        "matcher": "Write|StrReplace"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/ui-enforcement-check.mjs",
        "matcher": "Write|StrReplace"
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/ui-enforcement-check.mjs",
        "matcher": "Write|StrReplace"
      }
    ]
  }
}

{
	"name": "ScribeFloat",
	"version": "0.2.195",
	"description": "",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:tauri": "VITE_SKIP_ONBOARDING=1 vite dev",
		"dev:onboarding": "VITE_FORCE_ONBOARDING=1 vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:ds": "node scripts/check-design-system.mjs",
		"test:ui-enforcement": "node .cursor/hooks/ui-enforcement.test.mjs",
		"bump": "node scripts/bump-version.mjs",
		"devupdate": "npm update && cargo update --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
		"tauri": "tauri",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"license": "MIT",
	"dependencies": {
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.10",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/geist-sans": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.3",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"lucide-svelte": "^1.0.1",
		"tailwindcss": "^4.2.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.6.0",
		"jsdom": "^26.1.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "~5.6.2",
		"vite": "^6.0.3",
		"vitest": "^3.2.4"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}

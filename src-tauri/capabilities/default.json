{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for app windows",
  "windows": ["scribe", "settings", "dictate", "transcribe"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Main App shell (label history) — Notes, Settings, Record, Upload",
  "windows": ["history"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "main-shell"
  ]
}
